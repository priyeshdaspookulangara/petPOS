# Standard .htaccess for a PHP application without specific rewrite rules for clean URLs.
# It's often good to disable directory listing and protect sensitive files.

# Prevent directory listing
Options -Indexes

# Deny access to sensitive files
<Files .htaccess>
    Require all denied
</Files>
<Files config/db.php>
    Require all denied
</Files>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>


# PHP settings (optional, can be set in php.ini)
# Ensure these are appropriate for your environment.
# These are examples and might have been set during previous steps.
# php_flag display_errors Off # For production (On for development)
# php_value error_log logs/php_errors.log # Ensure logs directory is writable
# php_flag log_errors On
# php_value error_reporting E_ALL


# If your server doesn't automatically pick up index.php in a directory,
# you might need:
# DirectoryIndex index.php

# All RewriteRules related to clean URL mapping have been removed.
# The application will now rely on standard query parameters like:
# index.php?page=login
# index.php?module=inventory&action=products
# index.php?module=inventory&action=products&sub_action=edit&id=123
# etc.
#
# The previous RewriteEngine On and RewriteRule directives were here.
# Example of what was removed:
# RewriteEngine On
# RewriteBase /
# RewriteCond %{REQUEST_FILENAME} -s [OR]
# RewriteCond %{REQUEST_FILENAME} -l [OR]
# RewriteCond %{REQUEST_FILENAME} -d
# RewriteRule ^.*$ - [NC,L]
# RewriteRule ^(login|logout|dashboard)$ index.php?page=$1 [NC,L,QSA]
# RewriteRule ^([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/([0-9A-Za-z_-]+)$ index.php?module=$1&action=$2&id=$3 [NC,L,QSA]
# RewriteRule ^([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ index.php?module=$1&action=$2 [NC,L,QSA]
# RewriteRule ^([a-zA-Z0-9_-]+)/?$ index.php?module=$1 [NC,L,QSA]
# RewriteCond %{REQUEST_FILENAME} !-f
# RewriteCond %{REQUEST_FILENAME} !-d
# RewriteRule ^(.*)$ index.php [L,QSA]
